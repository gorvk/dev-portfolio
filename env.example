# rename this file into .env file and add following values for variables

# assign your github username to GITHUB_USERNAME variable
GITHUB_USERNAME=username

# refer below link for generating github api token and assign to GITHUB_API_KEY variable - 
# https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens#creating-a-fine-grained-personal-access-token
GITHUB_API_KEY=api_key